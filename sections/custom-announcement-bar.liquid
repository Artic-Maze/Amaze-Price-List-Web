{% comment %}
  Custom announcement bar.

  Structure follows sections/base.liquid: a scoped <style> block keyed on
  section.id, a .section-container--{{ section.id }} wrapper carrying the
  spacing settings, a .section-wrapper--{{ section.id }} inner, then the schema.

  Behaviour lives in assets/custom-header.js as the <announcement-bar>
  custom element.
{% endcomment %}

<script src="{{ 'custom-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign block_count = section.blocks.size
  assign is_revolving = false
  if section.settings.layout == 'revolving' and block_count > 1
    assign is_revolving = true
  endif
  assign track_align = section.settings.alignment | default: 'center'
-%}

<style>
  .section-container--{{ section.id }} {
    /* announcement-bar is a custom element: without this it defaults to
       display:inline and the bar cannot span the viewport. */
    display: block;
    --announce-height: {% if section.settings.layout == 'grouped' %}var(--usp-grouped-height, 5.8rem){% else %}var(--usp-revolving-height, 4.8rem){% endif %};
    margin-top: {{ section.settings.margin_top | append: 'px' }};
    margin-bottom: {{ section.settings.margin_bottom | append: 'px' }};
    padding-top: {{ section.settings.padding_top | append: 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | append: 'px' }};
    {% if section.settings.bg_color != blank %}background: {{ section.settings.bg_color }};{% endif %}
    {% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}
    {% if section.settings.show_border %}
      border-bottom: var(--fds-border-width-fine, 0.1rem) solid var(--fds-color-border-default, #dee0e3);
    {% endif %}
    position: relative;
    overflow: hidden;
  }

  .section-container--{{ section.id }}[hidden] {
    display: none;
  }

  .section-wrapper--{{ section.id }} {
    display: flex;
    align-items: center;
    gap: var(--global-spacing-16, 1.6rem);
    min-height: var(--announce-height);
  }

  .section-container--{{ section.id }} {
    .--announcement-viewport {
      position: relative;
      flex: 1 1 auto;
      min-width: 0;
    }

    .--announcement-track {
      display: flex;
      align-items: center;
      justify-content: {{ track_align }};
      gap: var(--global-spacing-40, 4rem);
    }

    .--announcement-item {
      display: flex;
      align-items: center;
      justify-content: {{ track_align }};
      min-width: 0;
      font-family: var(--fds-type-meta-family, inherit);
      font-size: var(--fds-type-meta-size, 1.2rem);
      line-height: var(--fds-type-meta-leading, 1.3);
      {% if section.settings.uppercase %}
        text-transform: var(--global-type-case-upper, uppercase);
        letter-spacing: 0.08em;
      {% endif %}
    }

    .--announcement-link {
      display: inline-flex;
      align-items: center;
      gap: var(--global-spacing-8, 0.8rem);
      color: inherit;
      text-decoration: none;
      min-width: 0;
    }

    a.--announcement-link {
      text-underline-offset: 0.3em;
    }

    a.--announcement-link:hover .--announcement-text {
      text-decoration: underline;
    }

    .--announcement-text {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .--announcement-text p {
      margin: 0;
      font: inherit;
      letter-spacing: inherit;
    }

    .--announcement-item .--icon {
      flex: none;
    }

    .--announcement-arrow {
      transition: transform var(--duration-default, 200ms) var(--ease-out, ease-out);
    }

    a.--announcement-link:hover .--announcement-arrow {
      transform: translateX(0.3rem);
    }

    .--announcement-controls {
      display: flex;
      align-items: center;
      gap: var(--global-spacing-4, 0.4rem);
      flex: none;
    }

    .--announcement-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 3.2rem;
      height: 3.2rem;
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      cursor: pointer;
      border-radius: var(--fds-radii-angled, 0);
      opacity: 0.7;
      transition: opacity var(--duration-default, 200ms) var(--ease-out, ease-out);
    }

    .--announcement-btn:hover,
    .--announcement-btn:focus-visible {
      opacity: 1;
    }
  }

  {%- if is_revolving %}
    .section-container--{{ section.id }} .--announcement-track {
      display: grid;
    }

    .section-container--{{ section.id }} .--announcement-item {
      grid-area: 1 / 1;
      opacity: 0;
      visibility: hidden;
      transform: translateY(0.6rem);
      transition:
        opacity var(--duration-medium, 300ms) var(--ease-out, ease-out),
        transform var(--duration-medium, 300ms) var(--ease-out, ease-out),
        visibility 0s linear var(--duration-medium, 300ms);
    }

    .section-container--{{ section.id }} .--announcement-item.is-active {
      opacity: 1;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }
  {%- endif %}

  @media screen and (max-width: 768px) {
    .section-container--{{ section.id }} {
      margin-top: {{ section.settings.margin_top_mobile | append: 'px' }};
      margin-bottom: {{ section.settings.margin_bottom_mobile | append: 'px' }};
      padding-top: {{ section.settings.padding_top_mobile | append: 'px' }};
      padding-bottom: {{ section.settings.padding_bottom_mobile | append: 'px' }};
      {% unless section.settings.show_on_mobile %}display: none;{% endunless %}
    }

    .section-container--{{ section.id }} .--announcement-track {
      gap: var(--global-spacing-16, 1.6rem);
    }

    {%- if section.settings.layout == 'grouped' %}
      .section-container--{{ section.id }} .--announcement-item:not(:first-child) {
        display: none;
      }
    {%- endif %}
  }

  @media (prefers-reduced-motion: reduce) {
    .section-container--{{ section.id }} .--announcement-item,
    .section-container--{{ section.id }} .--announcement-arrow {
      transition-duration: 1ms;
    }
  }
</style>

{%- if block_count > 0 -%}
  <announcement-bar
    class="section-container--{{ section.id }} color-{{ section.settings.color_scheme }}"
    data-section-id="{{ section.id }}"
    data-layout="{{ section.settings.layout }}"
    data-auto-rotate="{{ section.settings.auto_rotate }}"
    data-rotate-speed="{{ section.settings.rotate_speed | times: 1000 }}"
    data-dismissible="{{ section.settings.dismissible }}"
  >
    <div class="section-wrapper--{{ section.id }}{% if section.settings.full_width != true %} page-width{% endif %}">
      <div
        class="--announcement-viewport"
        role="region"
        aria-label="{{ 'sections.header.announcement' | t }}"
        {% if is_revolving and section.settings.auto_rotate %}
          aria-live="polite"
          aria-atomic="true"
        {% endif %}
      >
        <div class="--announcement-track" data-announcement-track>
          {%- for block in section.blocks -%}
            {%- render 'custom-announcement-item', block: block, is_first: forloop.first -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if is_revolving or section.settings.dismissible -%}
        <div class="--announcement-controls">
          {%- if is_revolving -%}
            <button
              type="button"
              class="--announcement-btn"
              data-announcement-prev
              aria-label="{{ 'general.slider.previous_slide' | t }}"
            >
              {%- render 'custom-icons', name: 'chevron-left', size: 16 -%}
            </button>

            {%- if section.settings.auto_rotate -%}
              {%- comment -%}
                WCAG 2.2.2: auto-updating content needs an explicit pause control.
              {%- endcomment -%}
              <button
                type="button"
                class="--announcement-btn"
                data-announcement-toggle
                aria-pressed="false"
                aria-label="{{ 'general.slider.pause_slideshow' | t }}"
              >
                <span data-icon-pause>{%- render 'custom-icons', name: 'pause', size: 15 -%}</span>
                <span data-icon-play hidden>{%- render 'custom-icons', name: 'play', size: 15 -%}</span>
              </button>
            {%- endif -%}

            <button
              type="button"
              class="--announcement-btn"
              data-announcement-next
              aria-label="{{ 'general.slider.next_slide' | t }}"
            >
              {%- render 'custom-icons', name: 'chevron-right', size: 16 -%}
            </button>
          {%- endif -%}

          {%- if section.settings.dismissible -%}
            <button
              type="button"
              class="--announcement-btn"
              data-announcement-dismiss
              aria-label="{{ 'accessibility.close' | t }}"
            >
              {%- render 'custom-icons', name: 'close', size: 16 -%}
            </button>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Custom Announcement Bar",
  "tag": "aside",
  "class": "custom-announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "revolving", "label": "Revolving (one at a time)" },
        { "value": "grouped", "label": "Grouped (all side by side)" }
      ],
      "default": "revolving",
      "info": "Grouped shows only the first announcement on mobile."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "space-between", "label": "Spread (grouped only)" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase text",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show bottom border",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Allow shoppers to dismiss",
      "default": false,
      "info": "Stays hidden for the rest of the browsing session."
    },
    {
      "type": "header",
      "content": "Rotation"
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Rotate automatically",
      "default": true,
      "info": "Revolving layout only. Pauses on hover, on focus, and when the tab is hidden."
    },
    {
      "type": "range",
      "id": "rotate_speed",
      "min": 2,
      "max": 12,
      "step": 1,
      "unit": "s",
      "label": "Seconds per announcement",
      "default": 5
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "info": "Overrides the color scheme when set."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom (Mobile)",
      "default": 0
    }
  ],
  "blocks": [
    {
      "name": "Announcement",
      "type": "announcement",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Text",
          "default": "Free delivery over $75"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "check", "label": "Check" },
            { "value": "star", "label": "Star" },
            { "value": "tag", "label": "Tag" },
            { "value": "ruler", "label": "Ruler" },
            { "value": "spark", "label": "Spark" },
            { "value": "globe", "label": "Globe" }
          ],
          "default": "none"
        }
      ]
    }
  ]
}
{% endschema %}
