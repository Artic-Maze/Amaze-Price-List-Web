<style>
    .section-container--{{ section.id }}{
      margin-top: {{ section.settings.margin_top | append:'px' }};
      margin-bottom: {{ section.settings.margin_bottom | append:'px' }};
      padding-top: {{ section.settings.padding_top | append:'px' }};
      padding-bottom: {{ section.settings.padding_bottom | append:'px' }};
       background: {{ section.settings.bg-color }};
      overflow: hidden;
    }


    @media screen and (max-width: 768px){
      .section-container--{{ section.id }}{
        margin-top: {{ section.settings.margin_top_mobile | append:'px' }};
        margin-bottom: {{ section.settings.margin_bottom_mobile | append:'px'  }};
        padding-top: {{ section.settings.padding_top_mobile | append:'px' }};
        padding-bottom: {{ section.settings.padding_bottom_mobile | append:'px' }};
      }

    }
  .section-container--{{ section.id }}{
    .section-wrapper--{{ section.id }} {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .--nav-block-wrapper {
        display: flex;
        gap: 10px;
        align-items: flex-end;
        justify-content: space-between;
    }
    .swiper.swiper-{{ section.id }}.grid .swiper-wrapper{
          display: grid;
          grid-template-columns: 1fr 1fr 1fr;
          gap: 20px;
          @media(max-width: 768px){
            grid-template-columns: 1fr;
            gap: 10px;
          }

    }
        .swiper-{{ section.id }} .--nav-icon {
    top: 40%;
}

    .--section-product-card{
      display:none;
    }
    .--section-product-card.active{
      display: block;
    }






  }
</style>
<section class="section-container--{{ section.id }}" id="{{ section.settings.navid }}">
  <div
    class="section-wrapper--{{ section.id }}{% if section.settings.full_width != true %} page-width {% endif %}"
  >
    {% render 'top-block', section: section %}

    <div class="--featured-collection-tab-container">
      {% if section.blocks.size > 1 %}
        <div class="--nav-block-wrapper">
          {% if section.blocks.size > 1 %}
            <div class="--collection-tabs">
              {% for block in section.blocks %}
                <button
                  class="--featured-tabs-button {% if forloop.first %} active-btn {% endif %}"
                  data-tab="tab-{{ block.id }}"
                  data-handle="{{ block.settings.collection.handle }}"
                  data-url="{{ block.settings.collection.url }}"
                >
                  {% assign tab_title = block.settings.tab_title %}
                  {% if tab_title == blank %}
                    {% assign tab_title = block.settings.collection.title %}
                  {% endif %}

                  {{ tab_title }}
                </button>
              {% endfor %}
            </div>
          {% endif %}
          <div class="btn_container">
            {% assign show_all_url = section.blocks[0].settings.collection.url %}

            <a class="show-all-button" href="{{ show_all_url }}">
              {{- section.settings.button_label -}}
            </a>
          </div>
        </div>
      {% endif %}

      <!-- collection products to change by the tabs -->
      <div class="swiper swiper-{{ section.id }} {{ section.settings.display-type }}">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% assign collection = block.settings.collection %}
            {% for product in collection.products limit: 9 %}
              <!-- swiper js slider starts -->
              <div
                class=" swiper-slide --section-product-card {% if forloop.parentloop.first %}active{% endif %}"
                data-handle="{{ collection.handle }}"
              >
                {% # render 'card-product', card_product: product, section_id: section.id %}
                {% render 'custom-product-card', product: product %}
              </div>
            {% endfor %}
          {% endfor %}
        </div>
        {% comment %} {% if section.blocks.size > 1 %}
          <div class="--nav-icon swiper-button-prev swiper-button-prev--{{ section.id }}"></div>
          <div class="--nav-icon swiper-button-next swiper-button-next--{{ section.id }}"></div>
          <div class="swiper-pagination swiper-pagination--{{ section.id }}"></div>
        {% endif %} {% endcomment %}
        {% if section.blocks.size > 0 %}
        <div class="--nav-icon swiper-button-prev swiper-button-prev--{{ section.id }}">
         {% render 'all-icons', name: 'chevron-left' %}
        </div>
        <div class="--nav-icon swiper-button-next swiper-button-next--{{ section.id }}">
           {% render 'all-icons', name: 'chevron-right' %}
        </div>
        <div class="swiper-pagination swiper-pagination--{{ section.id }}"></div>
      {% endif %}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.section-container--{{ section.id }} .--featured-tabs-button');
    const product_cards = document.querySelectorAll('.section-container--{{ section.id }} .--section-product-card');
    const showAllBtn = document.querySelector('.section-container--{{ section.id }} .show-all-button');
    const activeCollectionUrl = document.querySelector(
      '.section-container--{{ section.id }} .--featured-tabs-button.active-btn'
    )?.dataset.url;

    showAllBtn?.href = activeCollectionUrl;
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // to make the btn active
        tabs.forEach((tab) => tab.classList.remove('active-btn'));
        tab.classList.add('active-btn');

        // show all button
        showAllBtn.href = tab.dataset.url;
        console.log((showAllBtn.href = tab.dataset.url));

        let activatedCollectionHandle = tab.dataset.handle;
        product_cards.forEach((card) => {
          card.classList.remove('active');
          if (card.dataset.handle == activatedCollectionHandle) {
            card.classList.add('active');
          }
        });
        window.initSwiper('{{ section.id }}');
      });
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    window.initSwiper('{{ section.id }}');
  });

  {% comment %} window.initSwiper = function (section_id) {
    const swiperEl = document.querySelector(`.swiper.swiper-${section_id}.slider`);
    if (!swiperEl) return null;

    // Destroy previous instance if it exists
    if (swiperEl.swiper) {
      swiperEl.swiper.destroy(true, true);
    }

    const nextEl = document.querySelector(`.swiper.swiper-${section_id} .swiper-button-next--${section_id}`);
    const prevEl = document.querySelector(`.swiper.swiper-${section_id} .swiper-button-prev--${section_id}`);
    const paginationEl = document.querySelector(`.swiper.swiper-${section_id} .swiper-pagination--${section_id}`);

    new Swiper(swiperEl, {
      slidesPerView: 1.2,
      spaceBetween: 16,
      slidesPerGroup: 1,
      watchOverflow: true,
      observer: true,
      observeParents: true,

      breakpoints: {
        768: {
          slidesPerView: 3,
          spaceBetween: 30,
          slidesPerGroup: 3,
        },
      },

      navigation:
        nextEl && prevEl
          ? {
              nextEl: nextEl,
              prevEl: prevEl,
            }
          : false,

      pagination: paginationEl
        ? {
            el: paginationEl,
            clickable: true,
          }
        : false,
    });
  }; {% endcomment %}
</script>

