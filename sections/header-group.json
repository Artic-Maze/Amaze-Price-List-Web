{
  "name": "t:sections.header.name",
  "type": "header",
  "sections": {
    "custom-announcement-bar": {
      "type": "custom-announcement-bar",
      "blocks": {
        "announcement-0": {
          "type": "announcement",
          "settings": {
            "text": "Open any product and watch the price build from your measurements",
            "link": "",
            "icon": "ruler"
          }
        },
        "announcement-1": {
          "type": "announcement",
          "settings": {
            "text": "Live pricing on every product",
            "link": "",
            "icon": "spark"
          }
        },
        "announcement-2": {
          "type": "announcement",
          "settings": {
            "text": "No quote forms, no waiting",
            "link": "",
            "icon": "check"
          }
        }
      },
      "block_order": [
        "announcement-0",
        "announcement-1",
        "announcement-2"
      ],
      "settings": {
        "full_width": false,
        "color_scheme": "scheme-3",
