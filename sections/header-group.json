        "padding_top": 0,
        "padding_bottom": 0,
        "margin_top_mobile": 0,
        "margin_bottom_mobile": 0,
        "padding_top_mobile": 0,
        "padding_bottom_mobile": 0
      }
    },
    "custom-header": {
