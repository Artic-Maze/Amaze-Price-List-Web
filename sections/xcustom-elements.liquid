<style>
  #shopify-section-{{ section.id }}{
   background: {{ section.settings.bg-color }};
  }
          .section-container--{{ section.id }}{
            margin-top: {{ section.settings.margin_top | append:'px' }};
            margin-bottom: {{ section.settings.margin_bottom | append:'px' }};
            padding-top: {{ section.settings.padding_top | append:'px' }};
            padding-bottom: {{ section.settings.padding_bottom | append:'px' }};
            {% comment %} background: {{ section.settings.bg-color }}; {% endcomment %}
            overflow: hidden;
            position: relative;
            color: {{ section.settings.content-color }};
          }


          @media screen and (max-width: 768px){
            .section-container--{{ section.id }}{
              margin-top: {{ section.settings.margin_top_mobile | append:'px' }};
              margin-bottom: {{ section.settings.margin_bottom_mobile | append:'px'  }};
              padding-top: {{ section.settings.padding_top_mobile | append:'px' }};
              padding-bottom: {{ section.settings.padding_bottom_mobile | append:'px' }};
            }
          }
        .section-container--{{ section.id }}{
         img.--section-bg {
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                object-position: center;
          }
        .section-wrapper--{{ section.id }} {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 20px;
            position: relative;
        }
      p.--caption.style_1 {
            display: flex;
            padding: 4px 10px;
            justify-content: center;
            align-items: center;
            gap: 10px;
            border-radius: 7px;
            background: #EBF1B1;
            max-width: max-content;
            margin: 0;
            color: #112F15;
            text-align: center;
            font-size: 14px;
            font-weight: 500;
            line-height: 1.3;
            text-transform: capitalize;
            margin: 0;
        }
        p.--caption.style_2 {
          color: #EBF1B1;
          font-size: 14px;
          font-weight: 500;
          line-height: 22.012px;
          text-transform: capitalize;
          display: flex;
          align-items: center;
          gap: 10px;
          margin: 0;
      }
        h2.--title {
            margin: 0;
        }
     .--content  {

          font-size: var(--Font-Size-Paragraph-Regular);
          line-height: var(--Line-Height-Paragraph-Regular);

      }
     .--content strong {
        font-family: var(--font-family-Body-Bold);
      }
     .--content   h4 {
          margin-block: 10px;
      }
        .--content p:first-child,
        .--content h4:first-child{
          margin-top: 0;
        }
        .--content p:last-child{
          margin-bottom: 0;
        }
       .--content ul {
        padding-left: 20px;
        li {
          list-style-type: disc;
        }
      }
       .--content ol {
        {% comment %} padding-left: 20px; {% endcomment %}
        li {
          list-style-type: decimal;
        }
      }

        .--button-wrapper {
          display: flex;
          gap: 20px;
          flex-wrap: wrap;
          
          @media(max-width: 768px){
          justify-content: center;
          gap: 10px;
         
          }
      }
      svg.--placeholder-image {
        display: block;
        aspect-ratio: 4/1;
        border: 1px solid;
        @media(max-width: 768px){
        aspect-ratio: 4/3;
        }
    }
    svg.--shape-placeholder-image {
      display: block;
      max-height: 100px;
      width: 100%;
      object-fit: contain;
      border: 1px solid;
  }
  .--media-wrapper :is(img, video) {
          max-width: 1000px;
        border-radius: 16px;
  }


  {{ section.settings.custom_liquid }}
        }
</style>

<section
  class="section-container--{{ section.id }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  id="{{ section.settings.navid }}"
>
  {% if section.settings['bg-image'] != blank %}
    {{
      section.settings['bg-image']
      | image_url: width: section.settings['bg-image'].width
      | image_tag: class: '--section-bg'
    }}
  {% endif %}

  <div class="section-wrapper--{{ section.id }}{% if section.settings.full_width != true %} page-width {% endif %}">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'caption' %}
          {% if block.settings.title != blank %}
            <p class="--caption {{ block.settings.style }} " >
              {% if block.settings.style == 'style_2' %}
                <svg width="40" height="3" viewBox="0 0 40 3" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M0 0H40V3H0V0Z" fill="#EBF1B1"/>
                </svg>
              {% endif %}
              {{ block.settings.title }}
            </p>
          {% endif %}
        {% when 'title' %}
          {% if block.settings.title != blank %}
            <h2 class="--title " >{{ block.settings.title }}</h2>
          {% endif %}
        {% when 'content' %}
          {% if block.settings.title != blank %}
            <div class="--content " >{{ block.settings.title }}</div>
          {% endif %}
        {% when 'button' %}
          {% if block.settings.primary_button_title != blank or block.settings.secondary_button_title != blank %}
            <div class="--button-wrapper " >
              {% if block.settings.primary_button_title != blank %}
                <a
                  class="button --primary-button-- {{ block.settings.primary_button_style | prepend: '--' }}"
                  {% if block.settings.open_in_new_tab == true %}
                    target="_blank"
                  {% endif %}
                  href="{{ block.settings.primary_button_url }}"
                >
                  {{- block.settings.primary_button_title -}}
                </a>
              {% endif %}
              {% if block.settings.secondary_button_title != blank %}
                <a
                  class="button --secondary-button-- {{ block.settings.secondary_button_style | prepend: '--' }}"
                  {% if block.settings.open_in_new_tab == true %}
                    target="_blank"
                  {% endif %}
                  href="{{ block.settings.secondary_button_url }}"
                >
                  {{- block.settings.secondary_button_title -}}
                </a>
              {% endif %}
            </div>
          {% endif %}
        {% when 'image' %}
          {% if block.settings.image != blank %}
            <div class="--image-wrapper " >
              {{ block.settings.image | image_url: width: block.settings.image.width | image_tag }}
            </div>
          {% else %}
           
            {{ 'image' | placeholder_svg_tag: '--placeholder-image' }}
          {% endif %}
        {% when 'video' %}
          <style>
               .section-container--{{ section.id }}{
                .--media-wrapper :is(img, video) {
                  width: 100%;
                  height: 100%;
                  display: block;
                  object-fit: cover;
                  object-position: center;
              }
                .--media-wrapper :is(svg) {
                  width: 100%;
                  height: 100%;
                  display: block;
                  object-fit: contain;
                  border: 1px solid #000;
              }


            /* Section Container end */
            }
          </style>

          {% if block.settings.video != blank %}
            <div class="--media-wrapper">
              {% assign desktop_video = block.settings.video %}
              {% assign mobile_video = block.settings.video_mobile %}
              {% assign desktop_source = null %}
              {% assign mobile_source = null %}

              {% if desktop_video and desktop_video.sources and desktop_video.sources.size > 0 %}
                {% assign desktop_max_height = 0 %}
                {% for source in desktop_video.sources %}
                  {% if source.format == 'mp4' and source.height and source.height > desktop_max_height %}
                    {% assign desktop_source = source %}
                    {% assign desktop_max_height = source.height %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              {% if mobile_video and mobile_video.sources and mobile_video.sources.size > 0 %}
                {% assign mobile_max_height = 0 %}

                {% for source in mobile_video.sources %}
                  {% if source.format == 'mp4' and source.height and source.height > mobile_max_height %}
                    {% assign mobile_source = source %}
                    {% assign mobile_max_height = source.height %}
                  {% endif %}
                {% endfor %}
              {% endif %}

              <video
                playsinline
                autoplay
                muted
                loop
                controls
                preload="metadata"
                crossorigin="anonymous"
              >
                {% if mobile_source != null %}
                  <source
                    src="{{ mobile_source.url }}"
                    type="{{ mobile_source.mime_type }}"
                    media="(max-width: 767px)"
                  >
                {% endif %}
                <source
                  src="{{ desktop_source.url }}"
                  type="{{ desktop_source.mime_type }}"
                  media="(min-width: 768px)"
                >
                <source
                  src="{{ desktop_source.url }}"
                  type="{{ desktop_source.mime_type }}"
                >
              </video>
            </div>
          {% else %}
            {{ 'image' | placeholder_svg_tag: '--placeholder-image' }}
          {% endif %}
      {% endcase %}
    {% endfor %}
  </div>
  {% assign shapeBlock = section.blocks | where: 'type', 'shape' | first %}
  {% if shapeBlock != blank %}
    {% if shapeBlock.settings.image != blank %}
      <style>
        .section-container--{{ section.id }} .--shape-wrapper {
          margin-top: {{ shapeBlock.settings.margin_top | append:'px' }};
          margin-bottom: {{ shapeBlock.settings.margin_bottom | append:'px' }};
        }
      </style>
      <div class="--shape-wrapper">
        {{ shapeBlock.settings.image | image_url: width: shapeBlock.settings.image.width | image_tag }}
      </div>
    {% else %}
      {{ 'image' | placeholder_svg_tag: '--shape-placeholder-image' }}
    {% endif %}
  {% endif %}
</section>

{% schema %}
{
  "name": "Custom Element",

  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Section",
      "default": false
    },
    {
      "type": "text",
      "id": "navid",
      "label": "Id(for navigation)"
    },
    {
      "type": "color",
      "id": "content-color",
      "label": "Content Color"
    },
    {
      "type": "color",
      "id": "bg-color",
      "label": "Background Color",
    },
    {
      "type": "image_picker",
      "id": "bg-image",
      "label": "Background Image"
    },
    {
      "type": "header",
      "content": "Desktop Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 50
    },
    {
      "type": "header",
      "content": "Mobile Spacing"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Top (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin Bottom (Mobile)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Top  (Mobile)",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Padding Bottom  (Mobile)",
      "default": 20
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Styles"
    }
  ],
  "blocks": [
    {
      "name": "Caption",
      "type": "caption",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Caption"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "default": "style_1",
          "options": [
            {
              "value": "style_1",
              "label": "Style 1"
            },
            {
              "value": "style_2",
              "label": "Style 2"
            }
          ]
        }
      ]
    },
    {
      "name": "Title",
      "type": "title",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "title",
          "label": "Title",
          "default": "Section Title"
        }
      ]
    },
    {
      "name": "Content",
      "type": "content",
      "settings": [
        {
          "type": "richtext",
          "id": "title",
          "label": "Title",
          "default": "<p>Lorem Ipsum is simply dummy text of the printing and typesetting industry. Lorem Ipsum has been the industry's standard dummy text ever since the 1500s, when an unknown printer took a galley of type and scrambled it to make a type specimen book.</p>"
        }
      ]
    },
    {
      "name": "Button",
      "type": "button",
      "settings": [
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        },
        {
          "type": "text",
          "id": "primary_button_title",
          "label": "Primary Button Title",
          "default": "Primary Button"
        },
        {
          "type": "url",
          "id": "primary_button_url",
          "label": "Primary Button Url"
        },
        {
          "type": "select",
          "id": "primary_button_style",
          "label": "Primary Button Style",
          "default": "primary-button",
          "options": [
            {
              "label": "Primary Button",
              "value": "primary-button"
            },
            {
              "label": "Secondary Button",
              "value": "secondary-button"
            },
            {
              "label": "Tertiary Button",
              "value": "tertiary-button"
            },
            {
              "label": "Outline Button",
              "value": "outline-button"
            }
          ]
        },
        {
          "type": "text",
          "id": "secondary_button_title",
          "label": "Secondary Button Title",
          "default": "Secondary Button"
        },
        {
          "type": "url",
          "id": "secondary_button_url",
          "label": "Secondary Button Url"
        },
        {
          "type": "select",
          "id": "secondary_button_style",
          "label": "Secondary Button Style",
          "default": "secondary-button",
          "options": [
            {
              "label": "Primary Button",
              "value": "primary-button"
            },
            {
              "label": "Secondary Button",
              "value": "secondary-button"
            },
            {
              "label": "Tertiary Button",
              "value": "tertiary-button"
            },
            {
              "label": "Outline Button",
              "value": "outline-button"
            }
          ]
        }
      ]
    },
    {
      "name": "Image",
      "type": "image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image "
        }
      ]
    },
    {
      "name": "Video",
      "type": "video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "video",
          "id": "video_mobile",
          "label": "Video (Mobile)"
        }
      ]
    },
    {
      "name": "Shape",
      "type": "shape",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image "
        },
        {
          "type": "range",
          "id": "margin_top",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Margin Top",
          "default": 0
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 200,
          "step": 2,
          "unit": "px",
          "label": "Margin Bottom",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "xCustom Element",
      "category": "Custom Sections",
      "blocks": [
        { "type": "caption" },
        { "type": "title" },
        { "type": "content" },
        { "type": "button" },
        { "type": "image" },
        { "type": "video" },
      ]
    }
  ]
}
{% endschema %}
