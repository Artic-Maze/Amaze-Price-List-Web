{% comment %}
  Renders the header logo.

  The lockup itself comes from snippets/custom-brand-lockup.liquid, shared
  with the footer. This snippet owns the header-specific wrapper: the link,
  the current-page state and the visually hidden shop name.

  Markup only; styling lives in sections/custom-header.liquid.

  Accepts:
  - section: {Object} the header section (required)

  Usage:
  {% render 'custom-header-logo', section: section %}
{% endcomment %}

{%- liquid
  assign logo = section.settings.logo
  assign logo_width = section.settings.logo_width | default: 130
  assign wordmark = section.settings.logo_text | default: shop.name
-%}

{%- capture logo_inner -%}
  {%- render 'custom-brand-lockup',
    logo: logo,
    text: wordmark,
    show_mark: section.settings.show_logo_mark,
    width: logo_width
  -%}
{%- endcapture -%}

{%- comment -%}
  Always a link, never a heading. The page's h1 belongs to its own content —
  on the homepage that is the hero headline — and a logo h1 would compete
  with it for both assistive tech and search engines.
{%- endcomment -%}

<a
  class="--header-logo"
  href="{{ routes.root_url }}"
  {% if request.page_type == 'index' %}
    aria-current="page"
  {% endif %}
>
  {{ logo_inner }}
  {%- if logo != blank -%}
    <span class="visually-hidden">{{ shop.name }}</span>
  {%- endif -%}
</a>
