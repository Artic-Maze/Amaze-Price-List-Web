{% comment %}
  Renders one step inside the custom steps strip.

  Markup only — styling lives in sections/custom-steps.liquid so the style
  block is emitted once per section rather than once per block.

  Accepts:
  - block:    {Object} the step block (required)
  - position: {Number} 1-based index, used for the auto number
  - auto:     {Boolean} generate the number from position instead of the block

  Usage:
  {% render 'custom-step-item', block: block, position: forloop.index, auto: auto_number %}
{% endcomment %}

{%- liquid
  assign marker = block.settings.number
  if auto
    if position < 10
      assign marker = position | prepend: '0'
    else
      assign marker = position
    endif
  endif
-%}

<li class="--step" {{ block.shopify_attributes }}>
  {%- if block.settings.icon != 'none' and block.settings.icon != blank -%}
    <span class="--step-icon" aria-hidden="true">
      {%- render 'custom-icons', name: block.settings.icon, size: 20 -%}
    </span>
  {%- endif -%}

  {%- if marker != blank -%}
    <span class="--step-number" aria-hidden="true">{{ marker }}</span>
  {%- endif -%}

  {%- if block.settings.title != blank -%}
    <h3 class="--step-title">{{ block.settings.title | escape }}</h3>
  {%- endif -%}

  {%- if block.settings.text != blank -%}
    <div class="--step-text">{{ block.settings.text }}</div>
  {%- endif -%}

  {%- if block.settings.link_label != blank -%}
    <a class="--step-link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
      <span>{{ block.settings.link_label | escape }}</span>
      {%- render 'custom-icons', name: 'arrow-right', size: 13 -%}
    </a>
  {%- endif -%}
</li>
