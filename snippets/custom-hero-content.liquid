{% comment %}
  Renders the hero's text column — eyebrow pill, heading, lede, buttons, chips.

  The heading is inline_richtext so a merchant can mark the accent phrase with
  <em> in the editor's italic control; <em> is restyled as the accent colour
  rather than italics. That keeps the demo's two-tone headline editable
  without splitting it across three separate text fields.

  Markup only; styling lives in sections/custom-hero.liquid.

  Accepts:
  - section: {Object} the hero section (required)

  Usage:
  {% render 'custom-hero-content', section: section %}
{% endcomment %}

{%- liquid
  assign chips = section.blocks | where: 'type', 'chip'
  assign heading_tag = section.settings.heading_tag | default: 'h1'
  assign has_primary = false
  assign has_secondary = false
  if section.settings.cta_primary_label != blank
    assign has_primary = true
  endif
  if section.settings.cta_secondary_label != blank
    assign has_secondary = true
  endif
-%}

<div class="--hero-content">
  {%- if section.settings.eyebrow != blank -%}
    <span class="--hero-eyebrow">{{ section.settings.eyebrow | escape }}</span>
  {%- endif -%}

  {%- if section.settings.heading != blank -%}
    <{{ heading_tag }} class="--hero-heading">{{ section.settings.heading }}</{{ heading_tag }}>
  {%- endif -%}

  {%- if section.settings.lede != blank -%}
    <div class="--hero-lede">{{ section.settings.lede }}</div>
  {%- endif -%}

  {%- if has_primary or has_secondary -%}
    <div class="--hero-cta">
      {%- if has_primary -%}
        <a
          class="--btn --btn-primary"
          {% if section.settings.cta_primary_link != blank %}
            href="{{ section.settings.cta_primary_link }}"
          {% else %}
            href="{{ routes.all_products_collection_url }}"
          {% endif %}
        >
          <span>{{ section.settings.cta_primary_label | escape }}</span>
          {%- render 'custom-icons', name: 'arrow-right', size: 15 -%}
        </a>
      {%- endif -%}

      {%- if has_secondary -%}
        <a
          class="--btn --btn-ghost"
          {% if section.settings.cta_secondary_link != blank %}
            href="{{ section.settings.cta_secondary_link }}"
          {% else %}
            href="{{ routes.all_products_collection_url }}"
          {% endif %}
        >
          <span>{{ section.settings.cta_secondary_label | escape }}</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if chips.size > 0 -%}
    <ul class="--hero-chips" role="list">
      {%- for block in chips -%}
        <li class="--hero-chip" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            {%- render 'custom-icons', name: block.settings.icon, size: 13, stroke: 2.2 -%}
          {%- endif -%}
          <span>{{ block.settings.text | escape }}</span>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>
